# ==========================================
# Application Settings
# ==========================================

PROJECT_NAME="SkillSync AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=True
HOST="0.0.0.0"
PORT=8000


# ==========================================
# Security & JWT
# ==========================================

SECRET_KEY="replace-with-a-secure-random-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440


# ==========================================
# MongoDB Atlas Configuration
# ==========================================

MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net"
MONGODB_DB_NAME="careerconnect_ai"
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=50


# ==========================================
# Neo4j Aura Graph Database Configuration
# ==========================================

NEO4J_URI="neo4j+s://<instance-id>.databases.neo4j.io"
NEO4J_USER="<neo4j-username>"
NEO4J_USERNAME="<neo4j-username>"
NEO4J_PASSWORD="<neo4j-password>"
NEO4J_DATABASE="<database-name>"
NEO4J_MAX_CONNECTION_POOL_SIZE=50

# Neo4j Aura Metadata
AURA_INSTANCEID="<instance-id>"
AURA_INSTANCENAME="<instance-name>"


# ==========================================
# LLM & GraphRAG Configuration
# ==========================================

# Ollama is running on the local host machine,
# while FastAPI runs inside Docker.
OLLAMA_BASE_URL="http://host.docker.internal:11434"
OLLAMA_MODEL="llama3:latest"
OLLAMA_EMBED_MODEL="nomic-embed-text:latest"
OLLAMA_REQUEST_TIMEOUT=120.0


# ==========================================
# File Upload Settings
# ==========================================

UPLOAD_DIR="/app/uploads/resumes"
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=["pdf", "docx"]

# ==========================================
# Gemini AI Configuration (Optional)
# ==========================================
GEMINI_API_KEY="your-gemini-api-key-here"

# ==========================================
# Gmail SMTP Email Dispatch (For Verification)
# ==========================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-16-char-app-password"
EMAILS_FROM_EMAIL="your-email@gmail.com"
EMAILS_FROM_NAME="CareerConnect AI"
FRONTEND_URL="http://localhost:8000"